# Public, non-secret URL used for canonical links, structured data, robots and sitemap.
VITE_PUBLIC_SITE_URL=https://trainnolimit.com

# Optional absolute URL or site-relative path for WeChat/Open Graph previews.
VITE_SOCIAL_IMAGE_URL=/icon-512.png

# Server-only AI provider configuration. Never prefix these with VITE_ or
# expose them in the web app / WeChat Mini Program bundle.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
