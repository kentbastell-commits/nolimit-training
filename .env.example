# Public, non-secret URL used for canonical links, structured data, robots and sitemap.
VITE_PUBLIC_SITE_URL=https://trainnolimit.com

# Optional absolute URL or site-relative path for WeChat/Open Graph previews.
VITE_SOCIAL_IMAGE_URL=/icon-512.png

# Server-only AI provider configuration. Never prefix these with VITE_ or
# expose them in the web app / WeChat Mini Program bundle.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Separate Feishu custom app used only for internal Company Operations. These
# values stay server-side; never expose them through a VITE_ variable.
FEISHU_ADMIN_APP_ID=
FEISHU_ADMIN_APP_SECRET=
# Generate at least 32 random characters. Rotate it to invalidate all sessions.
FEISHU_ADMIN_SESSION_SECRET=
FEISHU_ADMIN_OAUTH_REDIRECT_URI=https://trainnolimit.cn/api/companyOpsAuthCallback
FEISHU_ADMIN_AFTER_LOGIN_PATH=/company-ops
FEISHU_ADMIN_COOKIE_SECURE=true
FEISHU_ADMIN_FOUNDER_OPEN_IDS=
FEISHU_ADMIN_APP_ADMINS_ARE_FOUNDERS=false
FEISHU_ADMIN_TENANT_KEY=
FEISHU_ADMIN_BASE_APP_TOKEN=
FEISHU_TEAMOPS_BASE_APP_TOKEN=
FEISHU_GROWTH_BASE_APP_TOKEN=
FEISHU_ADMIN_START_HERE_URL=
FEISHU_ADMIN_EXPENSE_POLICY_URL=
FEISHU_ADMIN_COMMISSION_POLICY_URL=
# Optional: emitted as acknowledgeable policies when set
FEISHU_ADMIN_HANDBOOK_URL=
FEISHU_ADMIN_DATA_RULES_URL=
FEISHU_ADMIN_ONBOARDING_GUIDE_URL=
FEISHU_ADMIN_CONFIDENTIAL_FORM_URL=
FEISHU_ADMIN_EXPENSE_FORM_URL=
FEISHU_ADMIN_WEEKLY_REPORT_FORM_URL=
FEISHU_ADMIN_METRICS_FORM_URL=
FEISHU_ADMIN_INTERNAL_REQUEST_FORM_URL=
FEISHU_ADMIN_COMPANY_CALENDAR_URL=
FEISHU_ADMIN_CONTENT_CALENDAR_URL=
FEISHU_ADMIN_SHARED_ASSETS_FOLDER_TOKEN=
FEISHU_ADMIN_SHARED_ASSETS_FOLDER_URL=
# Optional table-ID pins. Normally the service discovers bilingual table names.
FEISHU_ADMIN_STAFF_TABLE_ID=
FEISHU_ADMIN_EXPENSES_TABLE_ID=
FEISHU_ADMIN_PAYROLL_TABLE_ID=
FEISHU_ADMIN_COMMISSION_TABLE_ID=
FEISHU_ADMIN_PERFORMANCE_TABLE_ID=
FEISHU_ADMIN_POLICY_ACKNOWLEDGEMENTS_TABLE_ID=
FEISHU_ADMIN_INTERNAL_REQUESTS_TABLE_ID=
FEISHU_ADMIN_ONBOARDING_TABLE_ID=
FEISHU_ADMIN_ONBOARDING_CASES_TABLE_ID=
FEISHU_ADMIN_ONBOARDING_TEMPLATES_TABLE_ID=
FEISHU_ADMIN_SUPPORT_TABLE_ID=
FEISHU_ADMIN_CONTENT_TABLE_ID=
FEISHU_ADMIN_LEADS_TABLE_ID=
FEISHU_ADMIN_PARTNERS_TABLE_ID=
FEISHU_ADMIN_CAMPAIGNS_TABLE_ID=
FEISHU_ADMIN_EXPERIMENTS_TABLE_ID=
FEISHU_ADMIN_WEEKLY_REPORTS_TABLE_ID=
FEISHU_ADMIN_METRICS_TABLE_ID=
FEISHU_ADMIN_GOALS_TABLE_ID=
FEISHU_ADMIN_KEY_DATES_TABLE_ID=

# Canonical browser/OAuth origin registered in Feishu Developer Console.
COMPANY_OPS_PUBLIC_URL=https://trainnolimit.cn

# Optional native Approval definition codes. The workspace gracefully uses
# its audited internal queue until each template has been created by an admin.
FEISHU_EXPENSE_APPROVAL_CODE=
FEISHU_LEAVE_APPROVAL_CODE=
FEISHU_TRAVEL_APPROVAL_CODE=
FEISHU_MARKETING_APPROVAL_CODE=
FEISHU_VENDOR_APPROVAL_CODE=
FEISHU_DISCOUNT_APPROVAL_CODE=
